{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watch-together",
  "main": "src/index.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Serve index.html for /room/<id> so the client-side router can handle it.
    "not_found_handling": "single-page-application",
    // Only API routes hit the Worker; everything else is served straight from static assets.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed Durable Objects are available on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
